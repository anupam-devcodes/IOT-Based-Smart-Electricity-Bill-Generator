if (power < 0) { 
27  
    power = fabs(power); 
  } 
 
  // Remove voltage noise 
  if (voltage < voltageCutoff) { 
    voltage = 0.0; 
  } 
 
  // If no AC source, current and power should be zero 
  if (voltage == 0.0) { 
    current = 0.0; 
    power = 0.0; 
  } 
 
  // Remove current noise 
  if (current < currentCutoff) { 
    current = 0.0; 
  } 
 
  // Remove power noise 
  if (power < powerCutoff || voltage == 0.0 || current == 0.0) { 
    power = 0.0; 
  } 
 
  // Demo mode: 
  // If AC/load is removed, reset energy and bill to zero 
  if (voltage == 0.0 && current == 0.0 && power == 0.0) { 
    totalKWh = 0.0; 
    totalCost = 0.0; 
  } 
 
  unsigned long currentMillis = millis(); 
  float timeElapsedHours = (currentMillis - lastMillis) / 3600000.0; 
  lastMillis = currentMillis; 
 
  // Energy increases only when real power is detected 
  if (power > powerCutoff) { 
    totalKWh += (power * timeElapsedHours) / 1000.0; 
  } 
 
  totalCost = totalKWh * costPerUnit; 
 
  Serial.println("---------------"); 
 
  Serial.print("Voltage RMS: "); 
  Serial.print(voltage, 2); 
