void calculateAndSendData() { 
Serial.println("Reading sensors..."); 
emon.calcVI(20, 2000); 
float voltage = emon.Vrms;       
float current = emon.Irms;       
// RMS voltage 
// RMS current 
float power   = emon.realPower;  // Real power in watts 
